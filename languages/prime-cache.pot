#: includes/admin/class-admin-settings.php:1798
msgid "Auto-Optimize on Upload"
msgstr ""

#: includes/admin/class-admin-settings.php:1799
msgid "Automatically convert images when they are uploaded to the media library."
msgstr ""

#: includes/admin/class-admin-settings.php:1806
msgid "Delete Larger Conversions"
msgstr ""

#: includes/admin/class-admin-settings.php:1807
msgid "If the converted file is larger than the original, delete it automatically."
msgstr ""

#: includes/admin/class-admin-settings.php:1814
msgid "Exclude PNG Files"
msgstr ""

#: includes/admin/class-admin-settings.php:1815
msgid "Skip PNG images during conversion. Useful for PNGs with transparency or sharp graphics where WebP conversion offers little benefit. JPEG images are still converted."
msgstr ""

#: includes/admin/class-admin-settings.php:1826
msgid "AVIF Conversion"
msgstr ""

#: includes/admin/class-admin-settings.php:1827
msgid "Prime Cache Pro adds AVIF conversion for smaller modern image delivery. WebP conversion remains available in Prime Cache Free."
msgstr ""

#: includes/admin/class-admin-settings.php:1836
msgid "Bulk Image Optimization"
msgstr ""

#: includes/admin/class-admin-settings.php:1837
msgid "Scan and optimize existing images in your media library. Progress is saved — you can pause and resume at any time."
msgstr ""

#: includes/admin/class-admin-settings.php:1839
msgid "Scan for Unoptimized Images"
msgstr ""

